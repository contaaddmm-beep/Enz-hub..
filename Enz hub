-- // Anti-Morte Ajustado (Reseta apenas o Farm e o Teleguiado, mantendo o Auto Attack intacto para você poder religar fácil)
local function ResetFunctions()
    getgenv().AutoFarmLevel = false
    getgenv().FlyTeleguiado = false
    BtnAutoFarm.Text = "Auto Farm (Level): OFF"
    BtnAutoFarm.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    BtnFlyTeleguiado.Text = "Fly Teleguiado (Mobs): OFF"
    BtnFlyTeleguiado.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    UpdateWarningState()
end

LocalPlayer.CharacterAdded:Connect(function(newChar)
    ResetFunctions()
    newChar:WaitForChild("Humanoid").Died:Connect(ResetFunctions)
end)

if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
    LocalPlayer.Character.Humanoid.Died:Connect(ResetFunctions)
end

-- // Loop Principal (Auto Attack separado e independente da morte)
RunService.Stepped:Connect(function()
    -- Auto Attack roda sempre que ligado, mesmo se o personagem estiver revivendo ou sem alvo
    if getgenv().AutoAttack then
        pcall(function()
            VirtualUser:Button1Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
            VirtualUser:Button1Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
        end)
    end

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return end
    
    local hrp = char.HumanoidRootPart
    local humanoid = char.Humanoid
    
    if getgenv().AutoFarmLevel and getgenv().FlyTeleguiado then
        local target = GetTargetByLevel()
        if target and target:FindFirstChild("HumanoidRootPart") then
            local targetHRP = target.HumanoidRootPart
            
            humanoid.PlatformStand = true
            local targetCFrame = targetHRP.CFrame * CFrame.new(0, 3, 2)
            hrp.CFrame = hrp.CFrame:Lerp(targetCFrame, 0.4)
            hrp.Velocity = Vector3.new(0, 0, 0)
        else
            humanoid.PlatformStand = false
            if WarningLabel then
                WarningLabel.Text = "⚠️ Missão concluída! Desative o Auto Farm e o Teleguiado para pegar outra missão."
                WarningLabel.TextColor3 = Color3.fromRGB(255, 220, 50)
            end
        end
    else
        humanoid.PlatformStand = false
    end
end)
